<?xml version="1.0" standalone="yes"?>
<jsp:root
  xmlns:jsp="http://java.sun.com/JSP/Page"
  version="2.0"
  xmlns:c="jakarta.tags.core" >
  <jsp:directive.page import="static java.lang.Math.*"/>
  <jsp:output omit-xml-declaration="false" />
  <jsp:directive.page contentType="image/svg+xml"  session="false"/>
  <jsp:scriptlet>
      response.setHeader("Cache-Control", "max-age=3600");
  </jsp:scriptlet>
  <c:set var="size" value="${param.size == null? '16' : param.size}" />
  <c:set var="color" value="${empty param.color ? '#000' : param.color}" />
  <c:set var="sides" value="${empty param.sides ? '3' : param.sides}" />
  <c:set var="angle" value="${empty param.angle ? '0' : param.angle}" />
  <c:set var="points">
    <jsp:scriptlet>
      long sides = Long.parseLong((String) pageContext.getAttribute("sides"));
      double angle = PI * 2 * Double.parseDouble((String) pageContext.getAttribute("angle")) / 360;
      for (int i = 0 ; i &lt; sides; i++) {
        double phi = PI * 2 * (i + 0.5d) / sides + angle;
        out.print((1d + sin(phi)) / 4);
        out.print(',');
        out.print((1d + cos(phi)) / 4);
        out.print(' ');
      }
    </jsp:scriptlet>
  </c:set>
  <svg xmlns="http://www.w3.org/2000/svg"
       width="${size}" height="${size}"
       viewBox="0 0 1 1"
       version="1.1"
  >
  <polygon points="${points}" fill="${color}" />
</svg>
</jsp:root>
